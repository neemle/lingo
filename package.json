{
  "name": "language-reader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve reader --host 127.0.0.1 --port 1420",
    "build": "ng build reader",
    "desktop": "cd apps/reader && tauri dev",
    "desktop:build": "cd apps/reader && tauri build",
    "test": "cargo test -p reader-core",
    "check": "npm run build && cargo test -p reader-core && cargo check -p language-reader",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@tauri-apps/api": "2.12.5",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@playwright/test": "^1.65.1",
    "@tauri-apps/cli": "^2.10.0",
    "typescript": "~6.0.0"
  }
}
