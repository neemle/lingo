{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lingo Reader",
  "version": "0.1.0",
  "identifier": "dev.maria.language-reader",
  "build": {
    "beforeDevCommand": "npm start --prefix ../..",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --prefix ../..",
    "frontendDist": "../../../dist/reader/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Lingo Reader",
        "width": 1380,
        "height": 900,
        "minWidth": 850,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; object-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Offline-first language reader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
