<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Library</OutputType>
    <IsAppExtension>true</IsAppExtension>
    <ApplicationId>dev.lingoreader.native.share</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <CodesignEntitlements>../Reader.Native/Platforms/iOS/ShareEntitlements.plist</CodesignEntitlements>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Reader.Native/Platforms/iOS/SharedImportFolder.cs" Link="SharedImportFolder.cs" />
    <_LinkNativeExecutableInputs Include="$(CodesignEntitlements)" Condition="$(RuntimeIdentifier.StartsWith('iossimulator-'))" />
  </ItemGroup>
  <!-- The iOS SDK tracks partial manifests but can reuse the bundle manifest after Info.plist changes. -->
  <Target Name="TrackShareExtensionManifest" BeforeTargets="_CompileAppManifest">
    <ItemGroup>
      <_CompileAppManifestInputFile Include="$(MSBuildProjectDirectory)/Info.plist" />
    </ItemGroup>
  </Target>
</Project>
