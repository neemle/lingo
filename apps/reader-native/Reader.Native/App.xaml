<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="Reader.Native.App">
 <Application.Resources>
  <ResourceDictionary>
   <Color x:Key="Paper">#F6F3EC</Color><Color x:Key="Ink">#2D312B</Color>
   <Color x:Key="Sage">#63725C</Color><Color x:Key="Accent">#A65F43</Color>
   <Style TargetType="ContentPage"><Setter Property="BackgroundColor" Value="{StaticResource Paper}" /></Style>
   <Style TargetType="Label"><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
   <Style TargetType="Button">
    <Setter Property="BackgroundColor" Value="{StaticResource Sage}" />
    <Setter Property="TextColor" Value="White" /><Setter Property="CornerRadius" Value="12" />
    <Setter Property="MinimumHeightRequest" Value="44" />
   </Style>
   <Style TargetType="Entry"><Setter Property="TextColor" Value="{StaticResource Ink}" /></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
