<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:Reader.Native.Controls" x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Reading.ReadingPage"
 Title="Читання">
 <ContentPage.Resources>
  <Style x:Key="ReaderColumnCaption" TargetType="Label">
   <Setter Property="FontSize" Value="11" />
   <Setter Property="FontAttributes" Value="Bold" />
   <Setter Property="CharacterSpacing" Value="1.3" />
   <Setter Property="TextColor" Value="{StaticResource Muted}" />
   <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style x:Key="ReaderMeta" TargetType="Label">
   <Setter Property="FontSize" Value="12" />
   <Setter Property="TextColor" Value="{StaticResource Muted}" />
   <Setter Property="VerticalOptions" Value="Center" />
  </Style>
  <Style x:Key="PlayerButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="MinimumHeightRequest" Value="34" />
   <Setter Property="Padding" Value="9,5" />
  </Style>
 </ContentPage.Resources>
 <ContentPage.MenuBarItems>
  <MenuBarItem Text="Читання">
   <MenuFlyoutItem Text="Знайти в документі…" Clicked="FindInDocumentClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="F" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Попереднє речення" Clicked="PreviousClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="[" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Наступне речення" Clicked="NextClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="]" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Відтворити / пауза" Clicked="ToggleSpeechClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="J" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Озвучити / повторити" Clicked="SpeakClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="R" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Вимова речення…" Clicked="EditSpeechTextClicked" IsEnabled="{Binding CanBookmark}" />
   <MenuFlyoutItem Text="Аналіз речення…" Clicked="OpenSentenceAnalysisClicked" IsEnabled="{Binding CanBookmark}" />
   <MenuFlyoutItem Text="Зупинити озвучення" Clicked="StopClicked">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="K" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
  </MenuBarItem>
 </ContentPage.MenuBarItems>
 <Grid x:Name="ReaderRoot" SizeChanged="WordPopupResized">
 <Grid Padding="30,22,30,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="13">
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16">
   <VerticalStackLayout Spacing="7">
    <Label Text="{Binding Document.Format}" Style="{StaticResource ReaderMeta}" />
    <Label Text="{Binding Document.Title, TargetNullValue='Читання'}" Style="{StaticResource SerifTitle}"
     FontSize="40" LineBreakMode="TailTruncation" MaxLines="1" />
   </VerticalStackLayout>
   <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
    <Button x:Name="InlinePdfToggle" Text="Сторінка PDF" Style="{StaticResource OutlineButton}" IsVisible="False"
     Clicked="ToggleInlinePdfClicked" SemanticProperties.Description="Перемкнути PDF і розпізнаний текст">
     <Button.Triggers>
      <DataTrigger TargetType="Button" Binding="{Binding Document.Format}" Value="pdf">
       <Setter Property="IsVisible" Value="True" />
      </DataTrigger>
     </Button.Triggers>
    </Button>
    <Button x:Name="InlinePdfFitToggle" Text="Ціла сторінка" Style="{StaticResource OutlineButton}"
     IsVisible="False" Clicked="ToggleInlinePdfFitClicked" />
    <Button Text="Оригінал" Style="{StaticResource OutlineButton}" IsVisible="{Binding CanViewOriginal}"
     Clicked="ViewOriginalClicked" SemanticProperties.Description="Переглянути оригінал документа" />
   </HorizontalStackLayout>
   <Grid Grid.Row="1" Grid.ColumnSpan="2" x:Name="PdfPageControls" IsVisible="False" Margin="0,8,0,0"
    ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="6">
    <Button x:Name="PreviousPdfPage" Text="‹" FontSize="23" MinimumWidthRequest="42" Style="{StaticResource PlayerButton}" Clicked="PreviousPdfPageClicked"
     IsEnabled="False" SemanticProperties.Description="Попередня сторінка PDF" />
    <Button Grid.Column="1" x:Name="JumpPdfPage" Text="Сторінка" Style="{StaticResource PlayerButton}"
     Clicked="JumpPdfPageClicked" IsEnabled="False" SemanticProperties.Description="Перейти за номером сторінки PDF" />
    <Button Grid.Column="2" x:Name="NextPdfPage" Text="›" FontSize="23" MinimumWidthRequest="42" Style="{StaticResource PlayerButton}" Clicked="NextPdfPageClicked"
     IsEnabled="False" SemanticProperties.Description="Наступна сторінка PDF" />
    <Label Grid.Column="5" x:Name="PdfPageStatus" Style="{StaticResource ReaderMeta}" />
    <Button Grid.Column="3" x:Name="RetryPdfOcr" Text="Повторити OCR" Style="{StaticResource PlayerButton}"
     Clicked="RetryPdfOcrClicked" IsVisible="False" />
    <Button Grid.Column="4" x:Name="RepairPdfText" Text="Розпізнати зі скану" Style="{StaticResource PlayerButton}"
     Clicked="RepairPdfTextClicked" IsVisible="False"
     SemanticProperties.Description="Уточнити розпізнаний текст цієї сторінки PDF" />
   </Grid>
  </Grid>

  <Grid Grid.Row="1" x:Name="SentenceToolbar" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
   <Button Text="До речення…" Style="{StaticResource OutlineButton}" Clicked="JumpSentenceClicked"
    IsEnabled="{Binding CanBookmark}" SemanticProperties.Description="Перейти до речення за номером" />
   <Button Grid.Column="1" Text="{Binding BookmarkAction}" Style="{StaticResource OutlineButton}"
    IsEnabled="{Binding CanBookmark}" Clicked="BookmarkClicked" />
   <Button Grid.Column="2" Text="Закладки" Style="{StaticResource OutlineButton}"
    IsEnabled="{Binding HasBookmarks}" Clicked="OpenBookmarksClicked" />
   <Button Grid.Column="3" Text="Нотатки" Style="{StaticResource OutlineButton}"
    IsEnabled="{Binding CanBookmark}" Clicked="OpenNotesClicked" />
   <Button Grid.Column="4" Text="Знайти" Style="{StaticResource OutlineButton}" Clicked="FindInDocumentClicked"
    IsEnabled="{Binding CanBookmark}" SemanticProperties.Description="Знайти в документі" />
  </Grid>

  <Border Grid.Row="2" BackgroundColor="{StaticResource Panel}" Stroke="{StaticResource BorderTone}"
   StrokeShape="RoundRectangle 11">
   <Border.Shadow><Shadow Brush="#434B30" Opacity="0.08" Radius="7" Offset="0,3" /></Border.Shadow>
   <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Grid Padding="17,7" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
     <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
      <Border x:Name="SourceLanguageBadge" Padding="6,3" Stroke="#DCE1D3" BackgroundColor="#E9ECE2"
       StrokeShape="RoundRectangle 4" VerticalOptions="Center">
       <Label x:Name="SourceLanguageCode" TextColor="{StaticResource Sage}" FontSize="10" FontAttributes="Bold" />
      </Border>
      <Label x:Name="SourceLanguageName" Style="{StaticResource ReaderMeta}" />
     </HorizontalStackLayout>
     <Label Grid.Column="1" Text="→" FontSize="19" VerticalOptions="Center" TextColor="{StaticResource Sage}" />
     <Button Grid.Column="2" x:Name="TargetLanguage" Text="Мова перекладу" HorizontalOptions="Start"
      Style="{StaticResource PlayerButton}" Clicked="ChooseTargetClicked"
      SemanticProperties.Description="Мова перекладу речення" />
     <Button Grid.Column="3" Text="A−" Style="{StaticResource PlayerButton}" Clicked="DecreaseReaderFont"
      SemanticProperties.Description="Зменшити шрифт читання" />
     <Button Grid.Column="4" Text="A+" Style="{StaticResource PlayerButton}" Clicked="IncreaseReaderFont"
      SemanticProperties.Description="Збільшити шрифт читання" />
     <Button Grid.Column="5" x:Name="ReaderLayoutButton" Text="Авто" Style="{StaticResource PlayerButton}"
      Clicked="ReaderLayoutClicked" SemanticProperties.Description="Змінити розкладку читання" />
    </Grid>
    <BoxView Grid.Row="1" Color="{StaticResource BorderTone}" HeightRequest="1" />
    <Grid Grid.Row="2" x:Name="ReadingColumns" ColumnDefinitions="*,*" RowDefinitions="*,0" ColumnSpacing="1"
     BackgroundColor="{StaticResource BorderTone}">
     <Grid x:Name="SourcePane" RowDefinitions="Auto,*" BackgroundColor="{StaticResource Panel}">
      <Grid Padding="16,10" ColumnDefinitions="*,Auto" ColumnSpacing="8" BackgroundColor="#F8F9F3">
       <Label Text="ОРИГІНАЛ" Style="{StaticResource ReaderColumnCaption}" />
       <Label Grid.Column="1" x:Name="SourceLocation" Style="{StaticResource ReaderMeta}" IsVisible="False" />
      </Grid>
      <controls:NativeReaderView Grid.Row="1" x:Name="SourceText" Text="{Binding Document.Text}" Blocks="{Binding Document.Blocks}"
       BackgroundColor="{StaticResource Panel}"
       SourceSelected="SourceSelected"
       SemanticProperties.Description="Оригінальний текст. Виділіть слово для картки.">
       <controls:NativeReaderView.Triggers>
        <DataTrigger TargetType="controls:NativeReaderView" Binding="{Binding Document.Format}" Value="pdf">
         <Setter Property="ReflowPdf" Value="True" />
        </DataTrigger>
       </controls:NativeReaderView.Triggers>
      </controls:NativeReaderView>
      <ScrollView Grid.Row="1" x:Name="InlinePdfViewport" IsVisible="False" SizeChanged="InlinePdfViewportChanged" Scrolled="InlinePdfViewportScrolled">
       <Grid x:Name="InlinePdfSurface" HorizontalOptions="Center" VerticalOptions="Start" SizeChanged="InlinePdfSurfaceChanged">
        <Image x:Name="InlinePdfImage" Aspect="AspectFit"
       SemanticProperties.Description="Оригінальна сторінка PDF">
       <Image.GestureRecognizers>
        <TapGestureRecognizer Tapped="InlinePdfTapped" />
       </Image.GestureRecognizers>
      </Image>
      <GraphicsView x:Name="InlinePdfHighlight" IsVisible="False" InputTransparent="True" />
       </Grid>
      </ScrollView>
     </Grid>

     <Grid Grid.Column="1" x:Name="TranslationPane" RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource Panel}">
      <Grid Padding="16,10" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6" BackgroundColor="#F8F9F3">
       <Label Text="ПЕРЕКЛАД" Style="{StaticResource ReaderColumnCaption}" VerticalOptions="Center" />
       <Button Grid.Column="1" x:Name="AutoTranslate" Text="Автопереклад"
        Style="{StaticResource PlayerButton}" Clicked="AutoTranslateClicked" />
       <Button Grid.Column="2" x:Name="PdfTranslationMode" Text="Верстка" IsVisible="False"
        Style="{StaticResource PlayerButton}" Clicked="TogglePdfTranslationLayout" />
       <Button Grid.Column="3" x:Name="TranslatePdfPage" Text="Перекласти сторінку" IsVisible="False"
        Style="{StaticResource PlayerButton}" Clicked="TranslatePdfPageClicked" />
      </Grid>
      <ScrollView Grid.Row="1" x:Name="TranslationViewport" SizeChanged="TranslationViewportReady"
       Loaded="TranslationViewportReady" Scrolled="TranslationViewportScrolled">
       <VerticalStackLayout Spacing="10" Padding="16,12">
        <Label x:Name="TranslationNotice" Style="{StaticResource ReaderMeta}" />
        <VerticalStackLayout x:Name="ParagraphBefore" Spacing="8" IsVisible="False" />
        <Border x:Name="ActiveTranslationCard" AutomationId="ActiveTranslationCard" BackgroundColor="#F6F4EB" StrokeThickness="0"
         StrokeShape="RoundRectangle 7" IsVisible="False">
         <Grid ColumnDefinitions="3,*">
          <BoxView Color="{StaticResource Accent}" />
          <Label Grid.Column="1" x:Name="SegmentTranslation" Margin="9,6,9,8" FontFamily="Georgia"
           FontSize="20" LineHeight="1.4" TextColor="#655F4D" />
         <Label Grid.Column="1" x:Name="SegmentTranslationHighlighted" IsVisible="False" Margin="9,6,9,8" FontFamily="Georgia"
           FontSize="20" LineHeight="1.4" TextColor="#655F4D" />
         </Grid>
        </Border>
        <VerticalStackLayout x:Name="ParagraphAfter" Spacing="8" IsVisible="False" />
        <Grid x:Name="ModelTranslationResult" ColumnDefinitions="Auto,*" ColumnSpacing="9" IsVisible="False">
         <ActivityIndicator x:Name="ModelTranslationBusy" IsVisible="False" Color="{StaticResource Sage}"
          WidthRequest="20" HeightRequest="20" VerticalOptions="Start" />
         <Label Grid.Column="1" x:Name="ModelTranslationText" FontFamily="Georgia" FontSize="19" />
         <Label Grid.Column="1" x:Name="ModelTranslationTextHighlighted" IsVisible="False" FontFamily="Georgia" FontSize="19" />
        </Grid>
        <FlexLayout x:Name="ModelTranslationActions" IsVisible="False" Wrap="Wrap">
         <Button x:Name="ModelSourceToggle" Text="Що переклав Qwen" Clicked="ToggleModelSourceClicked"
          Style="{StaticResource PlayerButton}" Margin="0,0,6,0" />
         <Button Text="Поширити переклад Qwen" Clicked="ShareModelTranslationClicked"
          Style="{StaticResource PlayerButton}" />
        </FlexLayout>
        <Border x:Name="ModelSourcePreview" IsVisible="False" Padding="12,8"
         BackgroundColor="#F6F4EB" StrokeThickness="0" StrokeShape="RoundRectangle 7">
         <Label x:Name="ModelSourceText" FontFamily="Georgia" FontSize="16" LineBreakMode="WordWrap" />
        </Border>
       </VerticalStackLayout>
      </ScrollView>
      <ScrollView Grid.Row="1" x:Name="PdfTranslationViewport" IsVisible="False"
       SizeChanged="PdfTranslationViewportChanged" Scrolled="PdfTranslationViewportScrolled">
       <Grid x:Name="PdfTranslationPaper" HorizontalOptions="Center" VerticalOptions="Start">
        <Image x:Name="PdfTranslationBackground" Aspect="AspectFit" InputTransparent="True" />
        <GraphicsView x:Name="PdfTranslationSurface">
         <GraphicsView.GestureRecognizers>
          <TapGestureRecognizer Tapped="TranslatedPdfTapped" />
         </GraphicsView.GestureRecognizers>
        </GraphicsView>
       </Grid>
      </ScrollView>
      <FlexLayout Grid.Row="2" Padding="10,2,10,8" Wrap="Wrap" JustifyContent="Start">
       <Button x:Name="ReadPdfTranslationText" Text="Увесь текст" IsVisible="False" Margin="0,3,5,0"
        Style="{StaticResource PlayerButton}" Clicked="ReadPdfTranslationTextClicked" />
       <Button x:Name="EditTranslation" Text="Додати свій переклад" Margin="0,3,5,0"
        Style="{StaticResource PlayerButton}" Clicked="EditTranslationClicked" />
       <Button x:Name="TranslateOffline" Text="Перекласти абзац офлайн" Margin="0,3,5,0"
        Style="{StaticResource PlayerButton}" Clicked="TranslateOfflineClicked" />
       <Button x:Name="TranslateSentence" Text="Перекласти речення" Margin="0,3,5,0"
        Style="{StaticResource PlayerButton}" Clicked="TranslateSentenceClicked" />
       <Button x:Name="TranslateWithModel" Text="Перекласти моделлю" Margin="0,3,5,0"
        Style="{StaticResource PlayerButton}" Clicked="TranslateWithModelClicked" />
       <Button x:Name="ShareTranslationPair" Text="Поширити пару" Margin="0,3,5,0"
        Style="{StaticResource PlayerButton}" Clicked="ShareTranslationPairClicked" IsVisible="False"
        SemanticProperties.Description="Поширити оригінал і показаний переклад" />
       <Button x:Name="OpenTranslationPackages" Text="Потрібні мовні пакети" Margin="0,3,0,0"
        Style="{StaticResource PlayerButton}" IsVisible="False" Clicked="OpenTranslationPackagesClicked" />
      </FlexLayout>
     </Grid>
    </Grid>
    <Grid Grid.Row="2" x:Name="PdfPageNotice" IsVisible="False">
     <ScrollView x:Name="PendingInlinePdfViewport" IsVisible="False" SizeChanged="InlinePdfViewportChanged">
       <Grid x:Name="PendingInlinePdfSurface" HorizontalOptions="Center" VerticalOptions="Start" SizeChanged="InlinePdfSurfaceChanged">
        <Image x:Name="PendingInlinePdfImage" Aspect="AspectFit"
      SemanticProperties.Description="Оригінальна сторінка PDF" />
       </Grid>
      </ScrollView>
     <Label x:Name="PdfPageMessage" Margin="18" Style="{StaticResource ReaderMeta}"
      HorizontalTextAlignment="Center" VerticalOptions="Center" />
     <Grid x:Name="DetachedPdfReader" IsVisible="False" RowDefinitions="*,Auto" RowSpacing="6">
      <Grid x:Name="DetachedReadingColumns" ColumnDefinitions="*,*" RowDefinitions="*,0" ColumnSpacing="1" BackgroundColor="#E1DFD4">
       <Grid x:Name="DetachedSourcePane" RowDefinitions="Auto,*" BackgroundColor="{StaticResource Panel}">
        <Label Text="ОРИГІНАЛ" Style="{StaticResource ReaderColumnCaption}" Margin="14,9" />
        <controls:NativeReaderView Grid.Row="1" x:Name="DetachedPdfText" ReflowPdf="True"
         BackgroundColor="{StaticResource Panel}" SourceSelected="DetachedPdfSelected"
         SemanticProperties.Description="Текст поточної сторінки PDF" />
        <ScrollView Grid.Row="1" x:Name="DetachedInlinePdfViewport" IsVisible="False" SizeChanged="InlinePdfViewportChanged" Scrolled="InlinePdfViewportScrolled">
         <Grid x:Name="DetachedInlinePdfSurface" HorizontalOptions="Center" VerticalOptions="Start" SizeChanged="InlinePdfSurfaceChanged">
          <Image x:Name="DetachedInlinePdfImage" Aspect="AspectFit" SemanticProperties.Description="Оригінальна сторінка PDF">
           <Image.GestureRecognizers>
            <TapGestureRecognizer Tapped="InlinePdfTapped" />
           </Image.GestureRecognizers>
          </Image>
          <GraphicsView x:Name="DetachedInlinePdfHighlight" IsVisible="False" InputTransparent="True" />
         </Grid>
        </ScrollView>
       </Grid>
       <Grid Grid.Column="1" x:Name="DetachedTargetPane" RowDefinitions="Auto,*" BackgroundColor="{StaticResource Panel}">
        <Grid Padding="14,5" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
         <Label Text="ПЕРЕКЛАД" Style="{StaticResource ReaderColumnCaption}" VerticalOptions="Center" />
         <Button Grid.Column="1" x:Name="DetachedPdfTranslationMode" Text="Верстка" IsVisible="False"
          Style="{StaticResource PlayerButton}" Clicked="TogglePdfTranslationLayout" />
         <Button Grid.Column="2" x:Name="DetachedTranslatePdfPage" Text="Перекласти сторінку" IsVisible="False"
          Style="{StaticResource PlayerButton}" Clicked="TranslatePdfPageClicked" />
        </Grid>
        <ScrollView Grid.Row="1" x:Name="DetachedTranslationViewport" SizeChanged="DetachedTranslationViewportReady"
         Scrolled="TranslationViewportScrolled">
         <VerticalStackLayout Padding="14,8" Spacing="8">
          <Label x:Name="DetachedReadiness" IsVisible="False" Style="{StaticResource ReaderMeta}" LineBreakMode="WordWrap" />
          <VerticalStackLayout x:Name="DetachedPassageBefore" Spacing="7" IsVisible="False" />
          <Border x:Name="DetachedTranslationPane" IsVisible="False" BackgroundColor="#F6F4EB" StrokeThickness="0"
           StrokeShape="RoundRectangle 7">
           <Grid ColumnDefinitions="3,*">
            <BoxView Color="{StaticResource Accent}" />
            <Label Grid.Column="1" x:Name="DetachedTranslation" Margin="9,6,9,8" FontFamily="Georgia" FontSize="19" LineHeight="1.4" />
            <Label Grid.Column="1" x:Name="DetachedTranslationHighlighted" Margin="9,6,9,8" IsVisible="False"
             FontFamily="Georgia" FontSize="19" LineHeight="1.4" />
           </Grid>
          </Border>
          <VerticalStackLayout x:Name="DetachedPassageAfter" Spacing="7" IsVisible="False" />
          <Grid x:Name="DetachedModelTranslationResult" ColumnDefinitions="Auto,*" ColumnSpacing="9" IsVisible="False">
           <ActivityIndicator x:Name="DetachedModelTranslationBusy" IsVisible="False" Color="{StaticResource Sage}"
            WidthRequest="20" HeightRequest="20" VerticalOptions="Start" />
           <Label Grid.Column="1" x:Name="DetachedModelTranslationText" FontFamily="Georgia" FontSize="18" />
           <Label Grid.Column="1" x:Name="DetachedModelTranslationTextHighlighted" IsVisible="False"
            FontFamily="Georgia" FontSize="18" />
          </Grid>
          <FlexLayout x:Name="DetachedModelTranslationActions" IsVisible="False" Wrap="Wrap">
           <Button x:Name="DetachedModelSourceToggle" Text="Що переклав Qwen" Clicked="ToggleModelSourceClicked"
            Style="{StaticResource PlayerButton}" Margin="0,0,6,0" />
           <Button Text="Поширити переклад Qwen" Clicked="ShareModelTranslationClicked" Style="{StaticResource PlayerButton}" />
          </FlexLayout>
          <Border x:Name="DetachedModelSourcePreview" IsVisible="False" Padding="12,8"
           BackgroundColor="#F6F4EB" StrokeThickness="0" StrokeShape="RoundRectangle 7">
           <Label x:Name="DetachedModelSourceText" FontFamily="Georgia" FontSize="16" LineBreakMode="WordWrap" />
          </Border>
         </VerticalStackLayout>
        </ScrollView>
        <ScrollView Grid.Row="1" x:Name="DetachedPdfTranslationViewport" IsVisible="False"
         SizeChanged="PdfTranslationViewportChanged" Scrolled="PdfTranslationViewportScrolled">
         <Grid x:Name="DetachedPdfTranslationPaper" HorizontalOptions="Center" VerticalOptions="Start">
          <Image x:Name="DetachedPdfTranslationBackground" Aspect="AspectFit" InputTransparent="True" />
          <GraphicsView x:Name="DetachedPdfTranslationSurface">
           <GraphicsView.GestureRecognizers>
            <TapGestureRecognizer Tapped="TranslatedPdfTapped" />
           </GraphicsView.GestureRecognizers>
          </GraphicsView>
         </Grid>
        </ScrollView>
       </Grid>
      </Grid>
      <FlexLayout Grid.Row="1" Padding="8,5" Wrap="Wrap" AlignItems="Center">
       <Button x:Name="DetachedReadPdfTranslationText" Text="Увесь текст" IsVisible="False" Margin="0,0,5,0"
        Style="{StaticResource PlayerButton}" Clicked="ReadPdfTranslationTextClicked" />
       <Button x:Name="DetachedPrevious" Text="‹" Clicked="PreviousDetachedSentenceClicked" Style="{StaticResource PlayerButton}"
        SemanticProperties.Description="Попереднє речення сторінки" />
       <Button x:Name="DetachedSpeak" Text="▶" Clicked="DetachedSpeakClicked" Style="{StaticResource PlayerButton}"
        Margin="5,0" SemanticProperties.Description="Озвучити речення сторінки" />
       <Button x:Name="DetachedStopSpeech" Text="■" Clicked="StopClicked" IsVisible="False"
        Style="{StaticResource PlayerButton}" Margin="0,0,5,0" SemanticProperties.Description="Зупинити озвучення" />
       <Button x:Name="DetachedEditSpeechText" Text="Вимова…" Clicked="EditDetachedSpeechTextClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedResumeSpeech" Text="Продовжити озвучення" IsVisible="False"
        Clicked="DetachedResumeSpeechClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedNext" Text="›" Clicked="NextDetachedSentenceClicked" Style="{StaticResource PlayerButton}"
        SemanticProperties.Description="Наступне речення сторінки" />
       <Button x:Name="DetachedTranslate" Text="Перекласти абзац офлайн" Clicked="DetachedTranslateClicked"
        Margin="5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedTranslateWithModel" Text="Перекласти моделлю"
        Style="{StaticResource PlayerButton}" Clicked="TranslateWithModelClicked" Margin="0,0,5,0" />
       <Button x:Name="DetachedAutoTranslate" Text="Автопереклад" Clicked="AutoTranslateClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedOpenTranslationPackages" Text="Мовні пакети" IsVisible="False"
        Clicked="OpenTranslationPackagesClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedEditTranslation" Text="Свій переклад…" Clicked="DetachedEditTranslationClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedShareTranslation" Text="Поширити пару" IsVisible="False"
        Clicked="DetachedShareTranslationClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button Text="Знайти" Clicked="FindInDocumentClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}"
        SemanticProperties.Description="Знайти в документі" />
       <Button x:Name="DetachedAnalyze" Text="Перевірка речення…" Clicked="DetachedAnalyzeClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedBookmark" Text="Закладка" Clicked="DetachedBookmarkClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedNote" Text="Нотатка…" Clicked="DetachedNoteClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedAnnotations" Text="Позначки" Clicked="DetachedAnnotationsClicked"
        Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Picker x:Name="DetachedVoicePicker" Title="Голос" SelectedIndexChanged="DetachedVoiceChanged"
        MaximumWidthRequest="148" SemanticProperties.Description="Голос для сторінки PDF" />
       <Label x:Name="DetachedSentenceStatus" Margin="5,0" Style="{StaticResource ReaderMeta}" />
      </FlexLayout>
     </Grid>
    </Grid>
    <Grid Grid.Row="3" x:Name="SourceHint" BackgroundColor="#FAFBF6" Padding="15,7">
     <Label Text="Виділіть слово в оригіналі, щоб переглянути значення чи додати його до словника."
      Style="{StaticResource ReaderMeta}" />
    </Grid>
   </Grid>
  </Border>

  <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="4">
   <Label Text="{Binding Error}" TextColor="{StaticResource Accent}" />
   <Border Grid.Row="1" x:Name="ReaderControls" AutomationId="ReadingControls" BackgroundColor="{StaticResource Panel}"
    Stroke="{StaticResource BorderTone}" StrokeShape="RoundRectangle 11">
    <Border.Shadow><Shadow Brush="#62644E" Opacity="0.09" Radius="10" Offset="0,4" /></Border.Shadow>
    <Grid RowDefinitions="Auto,Auto,Auto,3" RowSpacing="3">
     <Grid x:Name="PlayerMain" Margin="14,9,14,8" ColumnDefinitions="*,Auto,*"
      RowDefinitions="Auto,0" ColumnSpacing="10">
      <Grid x:Name="PlayerDocument" ColumnDefinitions="34,*" ColumnSpacing="8" VerticalOptions="Center">
       <Border Padding="7" BackgroundColor="#EEEBE0" Stroke="#E6E1D1" StrokeShape="RoundRectangle 4">
        <Image Source="nav_book.png" WidthRequest="18" HeightRequest="20" />
       </Border>
       <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
        <Label Text="{Binding Document.Title}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1" />
        <Label Text="{Binding Progress, StringFormat='Речення {0}'}" Style="{StaticResource ReaderMeta}" />
       </VerticalStackLayout>
      </Grid>
      <ScrollView Grid.Column="1" x:Name="PlayerTransport" Orientation="Horizontal"
       VerticalOptions="Center" HorizontalScrollBarVisibility="Never">
       <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
        <Button Text="‹" Style="{StaticResource PlayerButton}" Clicked="PreviousClicked"
         IsEnabled="{Binding CanInteract}" SemanticProperties.Description="Попереднє речення" />
        <Button x:Name="PrimarySpeech" Text="▶" Style="{StaticResource AccentButton}" TextColor="White" WidthRequest="42" HeightRequest="42"
         Padding="0" CornerRadius="21" FontSize="16" Clicked="ToggleSpeechClicked"
         IsEnabled="{Binding CanInteract}" SemanticProperties.Description="Відтворити озвучення" />
        <Button Text="›" Style="{StaticResource PlayerButton}" Clicked="NextClicked"
         IsEnabled="{Binding CanInteract}" SemanticProperties.Description="Наступне речення" />
        <Button Text="■" Style="{StaticResource PlayerButton}" Clicked="StopClicked"
         SemanticProperties.Description="Зупинити озвучення" />
       </HorizontalStackLayout>
      </ScrollView>
      <Grid Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="5" VerticalOptions="Center">
       <Picker x:Name="VoicePicker" Title="Голос" SelectedIndexChanged="VoiceChanged"
        HorizontalOptions="End" MaximumWidthRequest="155" SemanticProperties.Description="Голос для цієї мови" />
       <Button Grid.Column="1" x:Name="PlaybackOptionsButton" Text="⋯" Style="{StaticResource PlayerButton}"
        Clicked="TogglePlaybackOptions" SemanticProperties.Description="Параметри озвучення" />
      </Grid>
     </Grid>
     <VerticalStackLayout Grid.Row="1" x:Name="PlaybackOptions" Margin="14,0,14,6" Spacing="5" IsVisible="False">
      <BoxView HeightRequest="1" Color="{StaticResource BorderTone}" />
      <FlexLayout Wrap="Wrap" AlignItems="Center">
       <Picker x:Name="Rate" WidthRequest="74" Title="Темп" SelectedIndexChanged="SpeechPreferencesChanged" />
       <Button x:Name="PauseSpeech" Text="Пауза" Style="{StaticResource PlayerButton}" IsEnabled="False"
        Clicked="PauseClicked" PropertyChanged="PauseSpeechChanged" />
       <Button Text="Повторити" Margin="5,0,0,0" Style="{StaticResource PlayerButton}" Clicked="SpeakClicked"
        IsEnabled="{Binding CanInteract}" SemanticProperties.Description="Повторити поточне речення" />
       <Button Text="Вимова…" Margin="5,0,0,0" Style="{StaticResource PlayerButton}"
        Clicked="EditSpeechTextClicked" IsEnabled="{Binding CanBookmark}" SemanticProperties.Description="Редагувати вимову речення" />
       <HorizontalStackLayout Margin="5,0,0,0" Spacing="2">
        <CheckBox x:Name="ContinueSpeech" CheckedChanged="SpeechPreferencesChanged"
         SemanticProperties.Description="Автоматично озвучувати наступні речення" />
        <Label Text="Озвучувати наступні речення" Style="{StaticResource ReaderMeta}" />
       </HorizontalStackLayout>
      </FlexLayout>
      <Button HorizontalOptions="Start" x:Name="ResumeSpeech" Text="Продовжити зі збереженого слова"
       Style="{StaticResource PlayerButton}" Clicked="ResumeSpeechClicked" IsEnabled="{Binding CanInteract}" IsVisible="False" />
      <Label x:Name="VoiceStatus" Style="{StaticResource ReaderMeta}" IsVisible="False" />
     </VerticalStackLayout>
     <Label Grid.Row="2" x:Name="SpeechStatus" Text="" Margin="14,0,14,3" Style="{StaticResource ReaderMeta}">
      <Label.Triggers>
       <Trigger TargetType="Label" Property="Text" Value="">
        <Setter Property="IsVisible" Value="False" />
       </Trigger>
      </Label.Triggers>
     </Label>
     <ProgressBar Grid.Row="3" x:Name="PlayerProgress" HeightRequest="3" ProgressColor="#BC997A" />
    </Grid>
   </Border>
  </Grid>
 </Grid>
 <AbsoluteLayout x:Name="WordOverlay" IsVisible="False">
  <BoxView Color="Transparent" AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All">
   <BoxView.GestureRecognizers><TapGestureRecognizer Tapped="CloseWordPopupClicked" /></BoxView.GestureRecognizers>
  </BoxView>
  <Path x:Name="WordPointer" Data="M0,8 L8,0 L16,8 Z" Aspect="Fill" Fill="#FAFAF5" InputTransparent="True" />
  <Border x:Name="WordCard" IsVisible="False" Padding="14" BackgroundColor="#FAFAF5"
   Stroke="{StaticResource BorderTone}" StrokeShape="RoundRectangle 11">
   <ScrollView x:Name="WordCardScroll" VerticalScrollBarVisibility="Default">
    <VerticalStackLayout Spacing="10">
     <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <Label x:Name="SelectedWord" Style="{StaticResource SerifTitle}" FontSize="29" LineBreakMode="WordWrap" />
      <Button Grid.Column="1" Text="Слухати" Style="{StaticResource PlayerButton}" Clicked="SpeakPopupWordClicked"
       SemanticProperties.Description="Прослухати виділене слово мовою оригіналу" />
      <Button Grid.Column="2" Text="×" Style="{StaticResource PlayerButton}" Clicked="CloseWordPopupClicked"
       SemanticProperties.Description="Закрити пояснення слова" />
     </Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="10,6" BackgroundColor="#F3EDDA">
      <Label x:Name="WordTranslationGloss" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
       LineBreakMode="WordWrap" />
      <Button Grid.Column="1" x:Name="SpeakWordTranslation" Text="Слухати" Style="{StaticResource PlayerButton}"
       Clicked="SpeakPopupTranslationClicked" IsEnabled="False" SemanticProperties.Description="Прослухати переклад" />
     </Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
      <Entry x:Name="Translation" Placeholder="Ваш переклад" SemanticProperties.Description="Переклад виділеного слова"
       ReturnType="Done" Completed="SaveWordClicked" />
      <Button Grid.Column="1" Text="До словника" Style="{StaticResource AccentButton}"
       Clicked="SaveWordClicked" IsEnabled="{Binding CanInteract}" />
     </Grid>
     <FlexLayout Wrap="Wrap" AlignItems="Center">
      <Button Text="Слухати в реченні" Style="{StaticResource PlayerButton}" Clicked="SpeakPopupContextClicked"
       Margin="0,0,6,0" />
      <Button x:Name="OpenMeanings" Text="Словникові значення" Style="{StaticResource PlayerButton}"
       Clicked="OpenMeaningsClicked" IsVisible="False" Margin="0,0,7,0" />
      <Button x:Name="WordDetailsToggle" Text="Більше" Style="{StaticResource PlayerButton}"
       Clicked="ToggleWordDetailsClicked" />
     </FlexLayout>
     <Label x:Name="WordSyntaxHint" Style="{StaticResource ReaderMeta}" IsVisible="False" />
     <VerticalStackLayout x:Name="WordMeanings" IsVisible="False" Spacing="7" />
     <VerticalStackLayout x:Name="WordDetails" IsVisible="False" Spacing="8">
      <Label x:Name="KnowledgeAnalysis" Style="{StaticResource ReaderMeta}" />
     <FlexLayout Wrap="Wrap" AlignItems="Center">
      <Button x:Name="OpenSyntax" Text="Синтаксис" Style="{StaticResource PlayerButton}"
       Clicked="OpenSyntaxClicked" IsVisible="False" Margin="0,0,7,0" />
      <Button x:Name="OpenSpelling" Text="Перевірка слова…" Style="{StaticResource PlayerButton}"
       Clicked="OpenSpellingClicked" IsVisible="False" Margin="0,0,7,0" />
      <Button x:Name="OpenExpressionAnalysis" Text="Аналіз виразу" Style="{StaticResource PlayerButton}"
       Clicked="OpenExpressionAnalysisClicked" IsVisible="False" Margin="0,0,7,0" />
      <Button Text="Поширити виділене" Style="{StaticResource PlayerButton}" Clicked="ShareSelectionClicked"
       Margin="0,0,7,0" SemanticProperties.Description="Поширити виділений уривок оригіналу" />
      <Button x:Name="ExplainWord" Text="Пояснити з Qwen" Style="{StaticResource PlayerButton}" Clicked="ExplainWordClicked" />
      <Button Text="Перекласти виділення…" Style="{StaticResource PlayerButton}" Clicked="TranslateSelectionClicked" />
     </FlexLayout>
     <Label x:Name="WordSyntaxDetails" Style="{StaticResource ReaderMeta}" IsVisible="False" />
     <Grid x:Name="SelectedSenseRow" ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="False">
      <Label x:Name="SelectedSense" Style="{StaticResource ReaderMeta}" LineBreakMode="WordWrap"
       VerticalOptions="Center" />
      <Button Grid.Column="1" Text="Зняти вибір" Style="{StaticResource PlayerButton}" Clicked="ClearSenseClicked"
       SemanticProperties.Description="Прибрати вибране значення з картки" />
     </Grid>
     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
      <ActivityIndicator x:Name="WordExplanationBusy" IsVisible="False" WidthRequest="18" HeightRequest="18"
       VerticalOptions="Start" Color="{StaticResource Sage}" />
      <Label Grid.Column="1" x:Name="WordExplanationText" IsVisible="False" />
      <Button Grid.Column="2" Text="Слухати" Style="{StaticResource PlayerButton}"
       Clicked="SpeakPopupExplanationClicked" VerticalOptions="Start"
       IsVisible="{Binding Source={x:Reference WordExplanationText}, Path=IsVisible}"
       SemanticProperties.Description="Прослухати пояснення слова" />
     </Grid>
     <Picker x:Name="VocabularyReading" Title="Форма для словникової картки" IsVisible="False" />
     </VerticalStackLayout>
    </VerticalStackLayout>
   </ScrollView>
  </Border>

  <Border x:Name="DetachedWordCard" IsVisible="False" Padding="14" BackgroundColor="#FAFAF5"
   Stroke="{StaticResource BorderTone}" StrokeShape="RoundRectangle 11">
   <ScrollView x:Name="DetachedWordCardScroll" VerticalScrollBarVisibility="Default">
    <VerticalStackLayout Spacing="10">
     <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
      <Label x:Name="DetachedSelectedWord" Style="{StaticResource SerifTitle}" FontSize="29" LineBreakMode="WordWrap" />
      <Button Grid.Column="1" Text="Слухати" Style="{StaticResource PlayerButton}" Clicked="SpeakPopupWordClicked"
       SemanticProperties.Description="Прослухати виділене слово мовою оригіналу" />
      <Button Grid.Column="2" Text="×" Style="{StaticResource PlayerButton}" Clicked="CloseWordPopupClicked"
       SemanticProperties.Description="Закрити пояснення слова" />
     </Grid>
     <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="10,6" BackgroundColor="#F3EDDA">
      <Label x:Name="DetachedWordTranslationGloss" FontSize="20" FontAttributes="Bold" VerticalOptions="Center"
       LineBreakMode="WordWrap" />
      <Button Grid.Column="1" x:Name="DetachedSpeakWordTranslation" Text="Слухати" Style="{StaticResource PlayerButton}"
       Clicked="SpeakPopupTranslationClicked" IsEnabled="False" SemanticProperties.Description="Прослухати переклад" />
     </Grid>
     <Button x:Name="DetachedSaveWord" Text="До словника…" IsVisible="False" Clicked="DetachedSaveWordClicked"
      HorizontalOptions="Start" Style="{StaticResource AccentButton}" />
     <FlexLayout Wrap="Wrap" AlignItems="Center">
      <Button Text="Слухати в реченні" Style="{StaticResource PlayerButton}" Clicked="SpeakPopupContextClicked"
       Margin="0,0,6,0" />
      <Button x:Name="DetachedMeaningsButton" Text="Значення" Style="{StaticResource PlayerButton}"
       Clicked="OpenDetachedMeaningsClicked" Margin="0,0,6,0" />
      <Button x:Name="DetachedWordDetailsToggle" Text="Більше" Style="{StaticResource PlayerButton}"
       Clicked="ToggleWordDetailsClicked" />
     </FlexLayout>
     <Label x:Name="DetachedSyntaxHint" Style="{StaticResource ReaderMeta}" IsVisible="False" />
     <VerticalStackLayout x:Name="DetachedMeanings" IsVisible="False" Spacing="7" />
     <VerticalStackLayout x:Name="DetachedWordDetails" IsVisible="False" Spacing="8">
     <FlexLayout Wrap="Wrap" AlignItems="Center">
       <Button x:Name="DetachedOpenSyntax" Text="Синтаксис" IsVisible="False"
        Clicked="OpenSyntaxClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedAnalyzeSelection" Text="Аналіз виділення" IsVisible="False"
        Clicked="DetachedAnalyzeSelectionClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedExplainWord" Text="Пояснити з Qwen" IsVisible="False"
        Clicked="DetachedExplainWordClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedTranslateSelection" Text="Перекласти виділення…" IsVisible="False"
        Clicked="TranslateDetachedSelectionClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}" />
       <Button x:Name="DetachedShareSelection" Text="Поширити виділене" IsVisible="False"
        Clicked="DetachedShareSelectionClicked" Margin="0,0,5,0" Style="{StaticResource PlayerButton}"
        SemanticProperties.Description="Поширити виділений уривок сторінки PDF" />
     </FlexLayout>
     <Label x:Name="DetachedSyntaxDetails" Style="{StaticResource ReaderMeta}" IsVisible="False" />
     <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="7">
      <ActivityIndicator x:Name="DetachedWordExplanationBusy" IsVisible="False" WidthRequest="18" HeightRequest="18"
       VerticalOptions="Start" Color="{StaticResource Sage}" />
      <Label Grid.Column="1" x:Name="DetachedWordExplanationText" IsVisible="False" LineBreakMode="WordWrap" />
      <Button Grid.Column="2" Text="Слухати" Style="{StaticResource PlayerButton}"
       Clicked="SpeakPopupExplanationClicked" VerticalOptions="Start"
       IsVisible="{Binding Source={x:Reference DetachedWordExplanationText}, Path=IsVisible}"
       SemanticProperties.Description="Прослухати пояснення слова" />
     </Grid>
     </VerticalStackLayout>
    </VerticalStackLayout>
   </ScrollView>
  </Border>
 </AbsoluteLayout>
 </Grid>
</ContentPage>
