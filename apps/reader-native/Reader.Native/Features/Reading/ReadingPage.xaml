<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:Reader.Native.Controls" x:Class="Reader.Native.Features.Reading.ReadingPage"
 Title="Читання">
 <ContentPage.MenuBarItems>
  <MenuBarItem Text="Читання">
   <MenuFlyoutItem Text="Попереднє речення" Clicked="PreviousClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="[" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Наступне речення" Clicked="NextClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="]" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Озвучити / повторити" Clicked="SpeakClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="R" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Зупинити озвучення" Clicked="StopClicked">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="K" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
  </MenuBarItem>
 </ContentPage.MenuBarItems>
 <Grid Padding="28,18" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
   <Label Text="{Binding Document.Title}" FontSize="26" FontAttributes="Bold" />
   <Label Grid.Column="1" Text="{Binding Progress}" FontSize="16" TextColor="#63725C" />
   <Label Grid.Row="1" Text="{Binding TranslationStatus}" TextColor="#A65F43" FontSize="13" />
  </Grid>
  <Picker Grid.Row="1" x:Name="SentencePicker" Title="Перейти до речення"
   ItemsSource="{Binding Document.Sentences}" ItemDisplayBinding="{Binding Text}"
   SelectedIndex="{Binding Document.Position, Mode=OneWay}" SelectedIndexChanged="SentenceChanged" />
  <controls:NativeReaderView Grid.Row="2" x:Name="SourceText" Text="{Binding Document.Text}"
   HighlightStart="{Binding Sentence.StartUtf16}" SourceSelected="SourceSelected"
   SemanticProperties.Description="Оригінальний текст. Виділіть слово для картки." />
  <Border Grid.Row="3" x:Name="WordCard" IsVisible="False" Padding="16" Stroke="#D9DCCF"
   BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 12">
   <VerticalStackLayout Spacing="8">
    <Label x:Name="SelectedWord" FontSize="21" FontAttributes="Bold" />
    <Label Text="Автоматичний аналіз недоступний. Введіть перевірений вами український переклад." FontSize="12" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
     <Entry x:Name="Translation" Placeholder="Ваш перевірений переклад"
      SemanticProperties.Description="Український переклад виділеного слова" ReturnType="Done"
      Completed="SaveWordClicked" />
     <Button Grid.Column="1" Text="До словника" Clicked="SaveWordClicked" IsEnabled="{Binding CanInteract}" />
    </Grid>
   </VerticalStackLayout>
  </Border>
  <VerticalStackLayout Grid.Row="4" Spacing="8">
   <Label Text="{Binding Error}" TextColor="#A65F43" />
   <HorizontalStackLayout Spacing="10">
    <Button Text="← Назад" Clicked="PreviousClicked" IsEnabled="{Binding CanInteract}" />
    <Button Text="Далі →" Clicked="NextClicked" IsEnabled="{Binding CanInteract}" />
    <Button Text="Озвучити / повторити" Clicked="SpeakClicked" IsEnabled="{Binding CanInteract}" />
    <Button Text="Стоп" Clicked="StopClicked" />
    <Picker x:Name="Rate" WidthRequest="95" Title="Темп" SelectedIndex="1">
     <Picker.Items><x:String>0.75×</x:String><x:String>1×</x:String><x:String>1.25×</x:String></Picker.Items>
    </Picker>
   </HorizontalStackLayout>
   <Label x:Name="SpeechStatus" FontSize="12" TextColor="#63725C" />
  </VerticalStackLayout>
 </Grid>
</ContentPage>
