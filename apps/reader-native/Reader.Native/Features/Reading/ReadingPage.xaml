<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:models="clr-namespace:Reader.Contracts;assembly=Reader.Contracts"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:controls="clr-namespace:Reader.Native.Controls" x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Reading.ReadingPage"
 Title="Читання">
 <ContentPage.MenuBarItems>
  <MenuBarItem Text="Читання">
   <MenuFlyoutItem Text="Попереднє речення" Clicked="PreviousClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="[" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Наступне речення" Clicked="NextClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="]" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Озвучити / повторити" Clicked="SpeakClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="R" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Зупинити озвучення" Clicked="StopClicked">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="K" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
  </MenuBarItem>
 </ContentPage.MenuBarItems>
 <Grid Padding="28,18" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
  <Grid ColumnDefinitions="*,Auto">
   <Label Text="{Binding Document.Title}" FontSize="26" FontAttributes="Bold" />
   <Label Grid.Column="1" Text="{Binding Progress}" FontSize="16" TextColor="#63725C" />
  </Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
   <Picker x:Name="SentencePicker" Title="Перейти до речення"
   ItemsSource="{Binding Document.Sentences}" ItemDisplayBinding="{Binding Text, x:DataType=models:Sentence}"
    SelectedIndex="{Binding Document.Position, Mode=OneWay}" SelectedIndexChanged="SentenceChanged" />
   <Button Grid.Column="1" Text="{Binding BookmarkAction}" IsEnabled="{Binding CanBookmark}"
    Clicked="BookmarkClicked" />
   <Button Grid.Column="2" Text="Закладки" IsEnabled="{Binding HasBookmarks}" Clicked="OpenBookmarksClicked" />
   <Button Grid.Column="3" Text="Оригінал" IsVisible="{Binding CanViewOriginal}"
    Clicked="ViewOriginalClicked" SemanticProperties.Description="Переглянути оригінал документа" />
  </Grid>
  <Grid Grid.Row="2" x:Name="ReadingColumns" ColumnDefinitions="3*,2*" RowDefinitions="*,0"
   ColumnSpacing="16">
   <Grid RowDefinitions="Auto,*" RowSpacing="8">
    <Label Text="Оригінал" FontAttributes="Bold" />
    <controls:NativeReaderView Grid.Row="1" x:Name="SourceText" Text="{Binding Document.Text}"
     HighlightStart="{Binding Sentence.StartUtf16}" SourceSelected="SourceSelected"
     SemanticProperties.Description="Оригінальний текст. Виділіть слово для картки." />
   </Grid>
   <Border Grid.Column="1" x:Name="TranslationPane" Padding="12" Stroke="#D9DCCF"
    StrokeShape="RoundRectangle 12">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
     <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
      <Label Text="Переклад речення" FontAttributes="Bold" VerticalOptions="Center" />
      <Picker Grid.Column="1" x:Name="TargetLanguage" Title="Мова перекладу"
       SelectedIndexChanged="TargetChanged" SemanticProperties.Description="Мова перекладу речення" />
     </Grid>
     <ScrollView Grid.Row="1">
      <VerticalStackLayout Spacing="8">
       <Label x:Name="TranslationNotice" FontSize="13" />
       <Label x:Name="SegmentTranslation" FontSize="19" />
      </VerticalStackLayout>
     </ScrollView>
     <FlexLayout Grid.Row="2" Wrap="Wrap" JustifyContent="Start">
      <Button x:Name="EditTranslation" Text="Додати свій переклад" Margin="0,4,6,0"
       Clicked="EditTranslationClicked" />
      <Button x:Name="TranslateOffline" Text="Перекласти офлайн" Margin="0,4,0,0"
       Clicked="TranslateOfflineClicked" />
      <Button x:Name="OpenTranslationPackages" Text="Потрібні мовні пакети" Margin="0,4,0,0"
       IsVisible="False" Clicked="OpenTranslationPackagesClicked" />
     </FlexLayout>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" x:Name="WordCard" IsVisible="False" Padding="16" Stroke="#D9DCCF"
   BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 12">
   <VerticalStackLayout Spacing="8">
    <Label x:Name="SelectedWord" FontSize="21" FontAttributes="Bold" />
    <Label x:Name="KnowledgeAnalysis" FontSize="12" />
    <Button x:Name="ExplainWord" Text="Пояснити з Qwen" Clicked="ExplainWordClicked" />
    <Label x:Name="WordExplanationText" IsVisible="False" />
    <Picker x:Name="VocabularyReading" Title="Форма для словникової картки" IsVisible="False" />
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
     <Entry x:Name="Translation" Placeholder="Ваш перевірений переклад"
      SemanticProperties.Description="Український переклад виділеного слова" ReturnType="Done"
      Completed="SaveWordClicked" />
     <Button Grid.Column="1" Text="До словника" Clicked="SaveWordClicked" IsEnabled="{Binding CanInteract}" />
    </Grid>
   </VerticalStackLayout>
  </Border>
  <VerticalStackLayout Grid.Row="4" Spacing="8">
   <Label Text="{Binding Error}" TextColor="#A65F43" />
   <FlexLayout Wrap="Wrap" JustifyContent="Start">
    <Button Text="← Назад" Margin="0,0,8,6" Clicked="PreviousClicked" IsEnabled="{Binding CanInteract}" />
    <Button Text="Далі →" Margin="0,0,8,6" Clicked="NextClicked" IsEnabled="{Binding CanInteract}" />
    <Button Text="Озвучити / повторити" Margin="0,0,8,6" Clicked="SpeakClicked" IsEnabled="{Binding CanInteract}" />
    <Button x:Name="ResumeSpeech" Text="Продовжити зі збереженого слова" Margin="0,0,8,6"
     Clicked="ResumeSpeechClicked" IsEnabled="{Binding CanInteract}" IsVisible="False" />
    <Button x:Name="PauseSpeech" Text="Пауза" Margin="0,0,8,6" IsEnabled="False" Clicked="PauseClicked" />
    <Button Text="Стоп" Margin="0,0,8,6" Clicked="StopClicked" />
    <Picker x:Name="Rate" WidthRequest="95" Title="Темп" SelectedIndex="1" SelectedIndexChanged="SpeechPreferencesChanged">
     <Picker.Items><x:String>0.75×</x:String><x:String>1×</x:String><x:String>1.25×</x:String></Picker.Items>
    </Picker>
   </FlexLayout>
   <FlexLayout Wrap="Wrap" AlignItems="Center" JustifyContent="Start">
    <Picker x:Name="VoicePicker" Title="Голос" WidthRequest="240" Margin="0,0,12,0"
     SelectedIndexChanged="VoiceChanged" SemanticProperties.Description="Системний голос для цієї мови" />
    <CheckBox x:Name="ContinueSpeech" CheckedChanged="SpeechPreferencesChanged"
     SemanticProperties.Description="Автоматично озвучувати наступні речення" />
    <Label Text="Озвучувати наступні речення" VerticalOptions="Center" />
   </FlexLayout>
   <Label x:Name="VoiceStatus" FontSize="12" TextColor="#63725C" IsVisible="False" />
   <Label x:Name="SpeechStatus" FontSize="12" TextColor="#63725C" />
  </VerticalStackLayout>
 </Grid>
</ContentPage>
