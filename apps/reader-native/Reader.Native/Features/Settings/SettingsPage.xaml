<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Settings.SettingsPage" Title="Мови та ресурси">
 <ContentPage.Resources>
  <Style x:Key="ResourceCard" TargetType="Border">
   <Setter Property="Padding" Value="26" />
   <Setter Property="BackgroundColor" Value="{StaticResource Panel}" />
   <Setter Property="Stroke" Value="{StaticResource BorderTone}" />
   <Setter Property="StrokeShape" Value="RoundRectangle 10" />
  </Style>
  <Style x:Key="ResourceTitle" TargetType="Label" BasedOn="{StaticResource SerifTitle}">
   <Setter Property="FontSize" Value="24" />
   <Setter Property="TextColor" Value="{StaticResource Sage}" />
  </Style>
  <Style x:Key="ResourceDetail" TargetType="Label">
   <Setter Property="FontSize" Value="14" />
   <Setter Property="LineHeight" Value="1.25" />
   <Setter Property="TextColor" Value="{StaticResource Muted}" />
  </Style>
  <Style x:Key="CapabilityCell" TargetType="Label">
   <Setter Property="FontSize" Value="13" />
   <Setter Property="VerticalOptions" Value="Center" />
   <Setter Property="Margin" Value="0,4,8,4" />
  </Style>
  <Style x:Key="CapabilityHeader" TargetType="Label" BasedOn="{StaticResource CapabilityCell}">
   <Setter Property="FontAttributes" Value="Bold" />
   <Setter Property="TextColor" Value="{StaticResource Sage}" />
  </Style>
 </ContentPage.Resources>
 <ScrollView x:Name="SettingsScroll" SizeChanged="TranslationLayoutChanged">
  <VerticalStackLayout Padding="40,34,40,42" Spacing="20" MaximumWidthRequest="1000" HorizontalOptions="Fill">
   <VerticalStackLayout Spacing="8" Margin="0,0,0,8">
    <Label Text="Мови та ресурси" Style="{StaticResource SerifTitle}" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="Мовні пакети, голоси й резервні копії на цьому пристрої."
     Style="{StaticResource ResourceDetail}" />
   </VerticalStackLayout>

   <Border Style="{StaticResource ResourceCard}">
    <VerticalStackLayout Spacing="8">
     <Label Text="Мовні можливості" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Label Text="Каталог і ресурси цього пристрою. Докладніше про кожен стан — у підказці комірки."
      Style="{StaticResource ResourceDetail}" />
     <ScrollView Orientation="Horizontal">
      <VerticalStackLayout Spacing="4">
       <Grid ColumnDefinitions="126,76,90,81,81,88,82,76,82">
        <Label Grid.Column="0" Text="Мова" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="1" Text="OCR" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="2" Text="Озвучення" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="3" Text="З мови" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="4" Text="На мову" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="5" Text="Морфологія" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="6" Text="Синтаксис" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="7" Text="Вирази" Style="{StaticResource CapabilityHeader}" />
        <Label Grid.Column="8" Text="Приклади" Style="{StaticResource CapabilityHeader}" />
       </Grid>
       <BoxView HeightRequest="1" Color="{StaticResource BorderTone}" />
       <VerticalStackLayout x:Name="CapabilityRows" Spacing="0">
        <BindableLayout.ItemTemplate>
         <DataTemplate x:DataType="state:LanguageCapabilityProfile">
          <Grid ColumnDefinitions="126,76,90,81,81,88,82,76,82">
           <Label Text="{Binding Name}" Style="{StaticResource CapabilityHeader}" />
           <Label Grid.Column="1" Text="{Binding Ocr.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding Ocr.Detail}" SemanticProperties.Hint="{Binding Ocr.Detail}" />
           <Label Grid.Column="2" Text="{Binding Tts.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding Tts.Detail}" SemanticProperties.Hint="{Binding Tts.Detail}" />
           <Label Grid.Column="3" Text="{Binding TranslationOut.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding TranslationOut.Detail}" SemanticProperties.Hint="{Binding TranslationOut.Detail}" />
           <Label Grid.Column="4" Text="{Binding TranslationIn.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding TranslationIn.Detail}" SemanticProperties.Hint="{Binding TranslationIn.Detail}" />
           <Label Grid.Column="5" Text="{Binding Morphology.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding Morphology.Detail}" SemanticProperties.Hint="{Binding Morphology.Detail}" />
           <Label Grid.Column="6" Text="{Binding Syntax.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding Syntax.Detail}" SemanticProperties.Hint="{Binding Syntax.Detail}" />
           <Label Grid.Column="7" Text="{Binding Idioms.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding Idioms.Detail}" SemanticProperties.Hint="{Binding Idioms.Detail}" />
           <Label Grid.Column="8" Text="{Binding Examples.Label}" Style="{StaticResource CapabilityCell}"
            ToolTipProperties.Text="{Binding Examples.Detail}" SemanticProperties.Hint="{Binding Examples.Detail}" />
          </Grid>
         </DataTemplate>
        </BindableLayout.ItemTemplate>
       </VerticalStackLayout>
      </VerticalStackLayout>
     </ScrollView>
     <Label Text="— недоступно. «Встановлено» показує наявність ресурсу. «Перевірено» означає, що пробний переклад пройшов принаймні для одного маршруту цього напряму."
      Style="{StaticResource ResourceDetail}" />
     <Button x:Name="ExportCapabilities" Text="Зберегти профілі JSON" Clicked="ExportCapabilitiesClicked"
      IsEnabled="False" HorizontalOptions="Start" Style="{StaticResource OutlineButton}" />
     <Label x:Name="CapabilityStatus" TextColor="{StaticResource Accent}" />
    </VerticalStackLayout>
   </Border>

   <Border Style="{StaticResource ResourceCard}">
    <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanInteract}">
     <Label Text="Локальні дані" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Label Text="Резервна копія містить документи, оригінали й історію навчання."
      Style="{StaticResource ResourceDetail}" />
     <FlexLayout Wrap="Wrap" JustifyContent="Start">
      <Button Text="Експортувати резервну копію" Clicked="ExportClicked" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button Text="Поширити копію" Clicked="ExportClicked" CommandParameter="share" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button Text="Відновити з архіву" Clicked="RestoreClicked" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button Text="Зберегти оригінал" Clicked="OriginalClicked" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button Text="Поширити оригінал" Clicked="OriginalClicked" CommandParameter="share" Style="{StaticResource OutlineButton}" Margin="0,0,0,8" />
     </FlexLayout>
     <Label x:Name="Status" TextColor="{StaticResource Sage}" />
     <Label Text="{Binding Error}" TextColor="{StaticResource Accent}" />
    </VerticalStackLayout>
   </Border>

   <Border x:Name="TranslationSection" Style="{StaticResource ResourceCard}" SizeChanged="TranslationLayoutChanged">
    <VerticalStackLayout Spacing="12">
     <Label Text="Офлайн-переклад" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Label x:Name="RequestedTranslation" Style="{StaticResource ResourceDetail}" IsVisible="False" />
     <Picker x:Name="ModelChoice" Title="Мовний пакет" HorizontalOptions="Start" MinimumWidthRequest="230" />
     <FlexLayout Wrap="Wrap" JustifyContent="Start">
      <Button x:Name="DownloadRequested" Text="Завантажити всі потрібні пакети" Clicked="DownloadRequestedClicked"
       IsVisible="False" Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
      <Button x:Name="DownloadTranslation" Text="Завантажити пакет" Clicked="DownloadTranslationClicked"
       Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
      <Button x:Name="CancelDownload" Text="Зупинити завантаження" Clicked="CancelDownloadClicked"
       IsVisible="False" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="InstallTranslation" Text="Встановити мовний пакет із ZIP" Clicked="InstallTranslationClicked"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="VerifyTranslation" Text="Перевірити цілісність пакета" IsVisible="False" Clicked="VerifyTranslationClicked"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="ValidateTranslation" Text="Пробний офлайн-переклад" IsVisible="False" Clicked="ValidateTranslationClicked"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="RepairTranslation" Text="Завантажити пакет повторно" IsVisible="False" Clicked="RepairTranslationClicked"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="RemoveTranslation" Text="Видалити пакет перекладу" IsVisible="False" Clicked="RemoveTranslationClicked"
       Style="{StaticResource OutlineButton}" Margin="0,0,0,8" />
     </FlexLayout>
     <ProgressBar x:Name="DownloadProgress" IsVisible="False" ProgressColor="{StaticResource Accent}" />
     <Label x:Name="ModelStatus" Style="{StaticResource ResourceDetail}" />
     <BoxView HeightRequest="1" Color="{StaticResource BorderTone}" Margin="0,2" />
     <Label Text="Напрямки перекладу" FontAttributes="Bold" TextColor="{StaticResource Sage}" />
     <Label x:Name="TranslationPackages" Style="{StaticResource ResourceDetail}" />
    </VerticalStackLayout>
   </Border>

   <Border Style="{StaticResource ResourceCard}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Граматичний аналіз" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Label x:Name="KnowledgePackages" Style="{StaticResource ResourceDetail}" />
     <Button x:Name="InstallKnowledge" Text="Встановити або оновити пакет аналізу" Clicked="InstallKnowledgeClicked"
      Style="{StaticResource OutlineButton}" HorizontalOptions="Start" />
     <Label x:Name="KnowledgeStatus" Style="{StaticResource ResourceDetail}" />
    </VerticalStackLayout>
   </Border>

   <Border Style="{StaticResource ResourceCard}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Словникові значення" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Picker x:Name="LexicalChoice" Title="Мова словника" HorizontalOptions="Start" MinimumWidthRequest="230" />
     <FlexLayout Wrap="Wrap" JustifyContent="Start">
      <Button x:Name="DownloadLexical" Text="Завантажити словник" Clicked="DownloadLexicalClicked" IsEnabled="False"
       Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
      <Button x:Name="OpenLexical" Text="Встановити з файлу GZ" Clicked="OpenLexicalClicked" IsEnabled="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="StopLexical" Text="Зупинити" Clicked="StopLexicalClicked" IsVisible="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,0,8" />
     </FlexLayout>
     <ProgressBar x:Name="LexicalProgress" IsVisible="False" ProgressColor="{StaticResource Accent}" />
     <Label x:Name="LexicalStatus" Style="{StaticResource ResourceDetail}" />
    </VerticalStackLayout>
   </Border>

   <Border Style="{StaticResource ResourceCard}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Додаткові локальні моделі" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Label Text="Голоси Piper і Supertonic можна завантажити тут."
      Style="{StaticResource ResourceDetail}" />
     <Picker x:Name="OptionalModelChoice" Title="Додаткова модель" SelectedIndexChanged="OptionalModelChanged"
      HorizontalOptions="Start" MinimumWidthRequest="230" />
     <Label x:Name="OptionalModelMemory" IsVisible="False" Style="{StaticResource ResourceDetail}" />
     <FlexLayout Wrap="Wrap" JustifyContent="Start">
      <Button x:Name="DownloadOptionalModel" Text="Завантажити" Clicked="DownloadOptionalModelClicked" IsEnabled="False"
       Style="{StaticResource AccentButton}" Margin="0,0,8,8" />
      <Button x:Name="VerifyOptionalModel" Text="Перевірити файли" Clicked="VerifyOptionalModelClicked" IsEnabled="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="RollbackOptionalModel" Text="Відновити збережену копію" Clicked="RollbackOptionalModelClicked" IsEnabled="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="RepairOptionalModel" Text="Встановити з локального кешу" Clicked="RepairOptionalModelClicked" IsEnabled="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="RemoveOptionalModel" Text="Видалити файли" Clicked="RemoveOptionalModelClicked" IsEnabled="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,8,8" />
      <Button x:Name="StopOptionalModel" Text="Зупинити завантаження" Clicked="StopOptionalModelClicked" IsVisible="False"
       Style="{StaticResource OutlineButton}" Margin="0,0,0,8" />
     </FlexLayout>
     <ProgressBar x:Name="OptionalProgress" IsVisible="False" ProgressColor="{StaticResource Accent}" />
     <Label x:Name="OptionalModelRecovery" Style="{StaticResource ResourceDetail}" />
     <Label x:Name="OptionalModelStatus" Style="{StaticResource ResourceDetail}" />
    </VerticalStackLayout>
   </Border>

   <Border Style="{StaticResource ResourceCard}">
    <VerticalStackLayout Spacing="12">
     <Label Text="Голоси й розпізнавання" Style="{StaticResource ResourceTitle}" SemanticProperties.HeadingLevel="Level2" />
     <Label Text="Розпізнавання фотографій і системні голоси використовують мови пристрою. Межі слів показуються для голосів, які їх передають."
      Style="{StaticResource ResourceDetail}" />
     <Button Text="Відкрити перевірку нативного тексту й голосу" Clicked="ProbeClicked"
      Style="{StaticResource OutlineButton}" HorizontalOptions="Start" />
    </VerticalStackLayout>
   </Border>
  </VerticalStackLayout>
 </ScrollView>
</ContentPage>
