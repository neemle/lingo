<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:models="clr-namespace:Reader.Contracts;assembly=Reader.Contracts"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Vocabulary.VocabularyPage" Title="Словник">
 <Grid Padding="32" RowDefinitions="Auto,Auto,*" RowSpacing="18">
  <Label Text="Слова, які залишаються з вами" FontSize="30" FontAttributes="Bold" />
  <Label Grid.Row="1" Text="Збережені вами переклади та контекст. Обидва напрями повторюються окремо."
   TextColor="#63725C" />
  <CollectionView Grid.Row="2" ItemsSource="{Binding Snapshot.Vocabulary}">
   <CollectionView.EmptyView>
    <Label Text="Виділіть слово під час читання, щоб додати його сюди." />
   </CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="models:Vocabulary">
    <Border Padding="20" Margin="0,0,0,12" Stroke="#D9DCCF" BackgroundColor="#FFFDFA"
     StrokeShape="RoundRectangle 12">
     <VerticalStackLayout Spacing="8">
      <Label Text="{Binding Word}" FontSize="22" FontAttributes="Bold" />
      <Label Text="{Binding Translation}" FontSize="18" TextColor="#63725C" />
      <Label Text="{Binding Context}" FontSize="14" LineBreakMode="WordWrap" />
      <VerticalStackLayout Spacing="4">
       <VerticalStackLayout.Triggers>
        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Analysis}" Value="{x:Null}">
         <Setter Property="IsVisible" Value="False" />
        </DataTrigger>
       </VerticalStackLayout.Triggers>
       <Label Text="{Binding Analysis.Surface, StringFormat='У тексті: {0}'}" FontSize="13" />
       <Label Text="{Binding Analysis.Context}" FontSize="14" LineBreakMode="WordWrap">
        <Label.Triggers>
         <DataTrigger TargetType="Label" Binding="{Binding Analysis.Context}" Value="{x:Null}">
          <Setter Property="IsVisible" Value="False" />
         </DataTrigger>
        </Label.Triggers>
       </Label>
       <Label Text="{Binding Analysis.Source, StringFormat='Граматичний розбір: {0}'}" FontSize="12" />
      </VerticalStackLayout>
      <VerticalStackLayout Spacing="4">
       <VerticalStackLayout.Triggers>
        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Expression}" Value="{x:Null}">
         <Setter Property="IsVisible" Value="False" />
        </DataTrigger>
       </VerticalStackLayout.Triggers>
       <Label Text="{Binding Expression.Surface, StringFormat='У тексті: {0}'}" FontSize="13" />
       <Label Text="{Binding Expression.Context}" FontSize="14" LineBreakMode="WordWrap">
        <Label.Triggers>
         <DataTrigger TargetType="Label" Binding="{Binding Expression.Context}" Value="{x:Null}">
          <Setter Property="IsVisible" Value="False" />
         </DataTrigger>
        </Label.Triggers>
       </Label>
       <Label Text="{Binding Expression.Source, StringFormat='Джерело виразу: {0}'}" FontSize="12" />
      </VerticalStackLayout>
      <Label Text="{Binding Forward.Reviews, StringFormat='Прямий напрям: {0} повторень'}" FontSize="12" />
      <Label Text="{Binding Reverse.Reviews, StringFormat='Зворотний напрям: {0} повторень'}" FontSize="12" />
     </VerticalStackLayout>
    </Border>
   </DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentPage>
