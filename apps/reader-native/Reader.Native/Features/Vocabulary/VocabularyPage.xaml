<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:models="clr-namespace:Reader.Contracts;assembly=Reader.Contracts"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Vocabulary.VocabularyPage" Title="Словник">
 <Grid Padding="36,30,36,20" RowDefinitions="Auto,Auto,*" RowSpacing="17">
  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
   <VerticalStackLayout Spacing="5">
    <HorizontalStackLayout Spacing="12">
     <Label Text="Мій словник" Style="{StaticResource SerifTitle}" FontSize="42" SemanticProperties.HeadingLevel="Level1" />
     <Border Padding="9,4" StrokeThickness="0" StrokeShape="RoundRectangle 14"
      BackgroundColor="#E9EDDF" VerticalOptions="Center" MinimumWidthRequest="30">
      <Label x:Name="CollectionCount" Text="0" FontSize="12" HorizontalTextAlignment="Center"
       TextColor="{StaticResource Sage}" />
     </Border>
    </HorizontalStackLayout>
    <Label Text="Збережені переклади й контекст" TextColor="{StaticResource Muted}" FontSize="14" />
   </VerticalStackLayout>
   <Button Grid.Column="1" Text="Повторити слова" Style="{StaticResource AccentButton}" VerticalOptions="Center" Clicked="PracticeClicked" />
  </Grid>
  <VerticalStackLayout Grid.Row="1" Spacing="8">
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <Border Padding="6,0" Stroke="{StaticResource BorderTone}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Panel}">
     <Picker x:Name="CollectionPicker" Title="Добірка за документом" IsEnabled="False"
      SelectedIndexChanged="CollectionChanged" SemanticProperties.Description="Добірка за документом" />
    </Border>
    <Button Grid.Column="1" x:Name="ImportDictionary" Text="Імпорт словника" Style="{StaticResource OutlineButton}" Clicked="ImportClicked" />
   </Grid>
   <FlexLayout Wrap="Wrap" AlignItems="Center">
    <Button x:Name="ExportDictionary" Text="Зберегти словник" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
     IsEnabled="False" Clicked="ExportClicked" />
    <Button x:Name="ShareDictionary" Text="Поширити словник" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
     IsEnabled="False" Clicked="ExportClicked" CommandParameter="share" />
    <Button x:Name="ExportDictionaryCsv" Text="Зберегти CSV" Style="{StaticResource OutlineButton}"
     IsEnabled="False" Clicked="ExportClicked" CommandParameter="csv" SemanticProperties.Description="Зберегти слова й переклади у CSV" />
   </FlexLayout>
   <Label x:Name="ArchiveStatus" TextColor="{StaticResource Sage}" IsVisible="False" />
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
    <Border Stroke="{StaticResource BorderTone}" StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Panel}">
     <SearchBar x:Name="VocabularyQuery" Placeholder="Знайти слово, переклад або контекст" MaxLength="240"
      TextChanged="QueryChanged" BackgroundColor="Transparent" />
    </Border>
    <Button Grid.Column="1" x:Name="SemanticSearch" Text="За змістом (E5)" Style="{StaticResource OutlineButton}"
     IsEnabled="False" Clicked="SemanticClicked" />
   </Grid>
   <Label x:Name="SearchStatus" TextColor="{StaticResource Sage}" IsVisible="False" />
  </VerticalStackLayout>
  <Border Grid.Row="2" Stroke="{StaticResource BorderTone}" StrokeShape="RoundRectangle 10" BackgroundColor="{StaticResource Panel}">
   <CollectionView x:Name="VocabularyList">
    <CollectionView.EmptyView>
     <Label x:Name="EmptyVocabulary" Text="Виділіть слово під час читання, щоб додати його сюди."
      TextColor="{StaticResource Muted}" FontSize="14" Margin="24,27" />
    </CollectionView.EmptyView>
    <CollectionView.ItemTemplate>
     <DataTemplate x:DataType="models:Vocabulary">
      <Grid RowDefinitions="Auto,1">
       <Grid Padding="20,17" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Padding="6,3" Stroke="#DCE1D3" StrokeShape="RoundRectangle 4" BackgroundColor="#E9ECE2" VerticalOptions="Start" Margin="0,4,0,0">
         <Label Text="{Binding Language}" TextTransform="Uppercase" FontAttributes="Bold" FontSize="10"
          TextColor="{StaticResource Sage}" CharacterSpacing="0.5" />
        </Border>
        <VerticalStackLayout Grid.Column="1" Spacing="5">
         <Label Text="{Binding Word}" Style="{StaticResource SerifTitle}" FontSize="26" />
         <Label Text="{Binding Translation}" FontSize="15" TextColor="{StaticResource Sage}" />
         <Label Text="{Binding AcceptedTranslationsLabel, StringFormat='Варіанти: {0}'}" FontSize="13"
          TextColor="{StaticResource Sage}" LineBreakMode="WordWrap">
          <Label.Triggers>
           <DataTrigger TargetType="Label" Binding="{Binding AcceptedTranslationsLabel}" Value="">
            <Setter Property="IsVisible" Value="False" />
           </DataTrigger>
          </Label.Triggers>
         </Label>
         <VerticalStackLayout Spacing="3">
          <VerticalStackLayout.Triggers>
           <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Sense}" Value="{x:Null}">
            <Setter Property="IsVisible" Value="False" />
           </DataTrigger>
          </VerticalStackLayout.Triggers>
          <Label Text="{Binding Sense.Gloss}" FontSize="14" LineBreakMode="WordWrap" />
          <Label Text="{Binding Sense.SourceName}" TextColor="{StaticResource Muted}" FontSize="11" />
         </VerticalStackLayout>
         <Label Text="{Binding Context}" FontFamily="Georgia" FontAttributes="Italic" FontSize="14"
          TextColor="{StaticResource Muted}" LineBreakMode="WordWrap" Margin="0,3,0,0" />
         <VerticalStackLayout Spacing="3" Margin="0,5,0,0">
          <VerticalStackLayout.Triggers>
           <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Analysis}" Value="{x:Null}">
            <Setter Property="IsVisible" Value="False" />
           </DataTrigger>
          </VerticalStackLayout.Triggers>
          <Label Text="{Binding Analysis.Surface, StringFormat='У тексті: {0}'}" FontSize="12" />
          <Label Text="{Binding Analysis.Context}" FontSize="13" LineBreakMode="WordWrap">
           <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding Analysis.Context}" Value="{x:Null}">
             <Setter Property="IsVisible" Value="False" />
            </DataTrigger>
           </Label.Triggers>
          </Label>
          <Label Text="{Binding Analysis.Source, StringFormat='Граматичний розбір: {0}'}" TextColor="{StaticResource Muted}" FontSize="11" />
         </VerticalStackLayout>
         <VerticalStackLayout Spacing="3" Margin="0,5,0,0">
          <VerticalStackLayout.Triggers>
           <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Expression}" Value="{x:Null}">
            <Setter Property="IsVisible" Value="False" />
           </DataTrigger>
          </VerticalStackLayout.Triggers>
          <Label Text="{Binding Expression.Surface, StringFormat='У тексті: {0}'}" FontSize="12" />
          <Label Text="{Binding Expression.Context}" FontSize="13" LineBreakMode="WordWrap">
           <Label.Triggers>
            <DataTrigger TargetType="Label" Binding="{Binding Expression.Context}" Value="{x:Null}">
             <Setter Property="IsVisible" Value="False" />
            </DataTrigger>
           </Label.Triggers>
          </Label>
          <Label Text="{Binding Expression.Source, StringFormat='Джерело виразу: {0}'}" TextColor="{StaticResource Muted}" FontSize="11" />
         </VerticalStackLayout>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="2" Spacing="5" Margin="0,4,0,0">
         <Label Text="{Binding TargetLanguage, StringFormat='→ {0}'}" TextTransform="Uppercase" HorizontalTextAlignment="End"
          FontSize="11" TextColor="{StaticResource Sage}" />
         <Label Text="{Binding Forward.Reviews, StringFormat='Прямий · {0}'}" HorizontalTextAlignment="End"
          SemanticProperties.Description="{Binding Forward.Reviews, StringFormat='Повторень у прямому напрямі: {0}'}"
          TextColor="{StaticResource Muted}" FontSize="11" />
         <Label Text="{Binding Reverse.Reviews, StringFormat='Зворотний · {0}'}" HorizontalTextAlignment="End"
          SemanticProperties.Description="{Binding Reverse.Reviews, StringFormat='Повторень у зворотному напрямі: {0}'}"
          TextColor="{StaticResource Muted}" FontSize="11" />
         <Button Text="Варіанти" FontSize="11" HorizontalOptions="End" Style="{StaticResource OutlineButton}"
          Clicked="EditVariantsClicked" CommandParameter="{Binding .}"
          SemanticProperties.Description="{Binding Word, StringFormat='Редагувати варіанти перекладу для {0}'}" />
         <Button Text="Історія" FontSize="11" HorizontalOptions="End" Style="{StaticResource OutlineButton}"
          Clicked="ReviewHistoryClicked" CommandParameter="{Binding .}"
          SemanticProperties.Description="{Binding Word, StringFormat='Історія повторень картки {0}'}" />
         <Button Text="Поширити" FontSize="11" HorizontalOptions="End" Style="{StaticResource OutlineButton}"
          Clicked="ShareCardClicked" CommandParameter="{Binding .}"
          SemanticProperties.Description="{Binding Word, StringFormat='Поширити картку {0}'}" />
        </VerticalStackLayout>
       </Grid>
       <BoxView Grid.Row="1" Color="{StaticResource BorderTone}" />
      </Grid>
     </DataTemplate>
    </CollectionView.ItemTemplate>
   </CollectionView>
  </Border>
 </Grid>
</ContentPage>
