<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:models="clr-namespace:Reader.Contracts;assembly=Reader.Contracts"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Library.LibraryPage"
 Title="Бібліотека">
 <ContentPage.MenuBarItems>
  <MenuBarItem Text="Файл">
   <MenuFlyoutItem Text="Додати документ" Clicked="ImportClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="O" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
  </MenuBarItem>
 </ContentPage.MenuBarItems>
 <Grid Padding="32" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="18">
  <VerticalStackLayout Spacing="8">
   <Label Text="ВАШ ПРОСТІР ДЛЯ МОВ" FontSize="12" CharacterSpacing="3" TextColor="#63725C" />
   <Label Text="Що почитаємо сьогодні?" FontSize="32" FontAttributes="Bold" />
   <Label Text="Книжки, нотатки й нові слова. Усе зберігається на цьому пристрої." FontSize="16" />
  </VerticalStackLayout>
  <HorizontalStackLayout Grid.Row="1" Spacing="12">
   <Button Text="Додати документ" Clicked="ImportClicked" IsEnabled="{Binding CanInteract}" />
   <ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" />
   <Button Text="Розпізнати PDF" Clicked="ScanPdfClicked" IsEnabled="{Binding CanInteract}" />
  </HorizontalStackLayout>
  <VerticalStackLayout Grid.Row="2" Spacing="6">
   <Label Text="TXT · DOCX · PDF · фотографії. До 20 МБ."
    TextColor="#63725C" FontSize="13" />
   <Label Text="{Binding Error}" TextColor="#A65F43" SemanticProperties.Description="Помилка операції" />
   <Label x:Name="ImportStatus" TextColor="#63725C" />
   <Label x:Name="StartupError" TextColor="#A65F43" />
  </VerticalStackLayout>
  <CollectionView Grid.Row="3" ItemsSource="{Binding Snapshot.Documents}" SelectionMode="Single"
   SelectionChanged="DocumentSelected" IsEnabled="{Binding CanInteract}">
   <CollectionView.EmptyView>
    <Label Text="Додайте перший текст, щоб почати читання." Margin="0,32" />
   </CollectionView.EmptyView>
   <CollectionView.ItemTemplate><DataTemplate x:DataType="models:Document">
    <Border Padding="20" Margin="0,0,0,12" Stroke="#DEDCCF" BackgroundColor="#FFFDFA" StrokeShape="RoundRectangle 14">
     <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
      <Label Text="{Binding Title}" FontSize="21" FontAttributes="Bold" />
      <Button Grid.Column="1" Text="{Binding Language, StringFormat='Мова: {0}'}"
       SemanticProperties.Description="Змінити мову джерела" Clicked="ChangeLanguageClicked" CommandParameter="{Binding .}" />
      <Label Grid.Row="1" Text="{Binding Format}" TextColor="#63725C" />
      <Label Grid.Row="1" Grid.Column="1" Text="Читати →" TextColor="#A65F43" />
     </Grid>
    </Border>
   </DataTemplate></CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentPage>
