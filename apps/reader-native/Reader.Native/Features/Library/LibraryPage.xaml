<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
 xmlns:library="clr-namespace:Reader.Native.Features.Library"
 xmlns:state="clr-namespace:Reader.Presentation;assembly=Reader.Presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:DataType="state:ReaderSession"
 x:Class="Reader.Native.Features.Library.LibraryPage" Title="Бібліотека">
 <ContentPage.MenuBarItems>
  <MenuBarItem Text="Файл">
   <MenuFlyoutItem Text="Додати документ" Clicked="ImportClicked" IsEnabled="{Binding CanInteract}">
    <MenuFlyoutItem.KeyboardAccelerators>
     <KeyboardAccelerator Modifiers="{OnPlatform MacCatalyst=Cmd, WinUI=Ctrl}" Key="O" />
    </MenuFlyoutItem.KeyboardAccelerators>
   </MenuFlyoutItem>
   <MenuFlyoutItem Text="Історія читання" Clicked="ReadingHistoryClicked" IsEnabled="{Binding CanInteract}" />
   <MenuFlyoutItem Text="Додати статтю за посиланням" Clicked="ImportArticleClicked" IsEnabled="{Binding CanInteract}" />
  </MenuBarItem>
 </ContentPage.MenuBarItems>
 <Grid Padding="36,30,36,20" RowDefinitions="Auto,Auto,*" RowSpacing="18">
  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="11">
   <VerticalStackLayout Spacing="5">
    <Label Text="Бібліотека" Style="{StaticResource SerifTitle}" FontSize="42" SemanticProperties.HeadingLevel="Level1" />
    <Label Text="Книжки, нотатки й тексти на цьому пристрої." TextColor="{StaticResource Muted}" FontSize="14" />
   </VerticalStackLayout>
   <Button x:Name="LibraryActions" Grid.Row="1" Grid.ColumnSpan="2" Text="+ Додати документ"
    Style="{StaticResource AccentButton}" Clicked="ChooseImportSourceClicked" IsEnabled="{Binding CanInteract}"
    HorizontalOptions="Start" VerticalOptions="Center" SemanticProperties.Description="Додати документ" />
  </Grid>
  <VerticalStackLayout Grid.Row="1" Spacing="5">
   <Border Padding="12,9" Stroke="#D6D9CA" StrokeThickness="1" StrokeDashArray="5,4"
    StrokeShape="RoundRectangle 8" BackgroundColor="#F0F3E9">
    <Border.GestureRecognizers><DropGestureRecognizer Drop="FilesDropped" /></Border.GestureRecognizers>
    <Label Text="Перетягніть файл, фотографію, текст або посилання сюди"
     TextColor="{StaticResource Sage}" FontSize="13" />
   </Border>
   <FlexLayout Wrap="Wrap" AlignItems="Center">
    <ActivityIndicator IsRunning="{Binding Busy}" IsVisible="{Binding Busy}" Color="{StaticResource Sage}" />
    <Button Text="Історія" Margin="0,0,8,6" Style="{StaticResource OutlineButton}" Clicked="ReadingHistoryClicked"
     IsEnabled="{Binding CanInteract}" SemanticProperties.Description="Історія читання" />
    <Button x:Name="OpenShareInbox" Text="Вхідні матеріали" Margin="0,0,8,6" Style="{StaticResource OutlineButton}"
     Clicked="OpenShareInboxClicked" IsVisible="False" IsEnabled="{Binding CanInteract}" />
    <Button x:Name="PauseExternalBatch" Text="Призупинити добірку" Margin="0,0,8,6" Style="{StaticResource OutlineButton}"
     Clicked="PauseExternalBatchClicked" IsVisible="False" SemanticProperties.Description="Призупинити імпорт після поточного матеріалу" />
    <Button x:Name="ResumePdf" Text="Продовжити OCR" Margin="0,0,8,6" Style="{StaticResource OutlineButton}"
     Clicked="ResumePdfClicked" IsVisible="False" IsEnabled="{Binding CanInteract}" />
    <Button x:Name="PausePdf" Text="Призупинити OCR" Margin="0,0,8,6" Style="{StaticResource OutlineButton}"
     Clicked="PausePdfClicked" IsVisible="False" />
     Clicked="PasteImageClicked" IsEnabled="{Binding CanInteract}" />
   </FlexLayout>
   <Label Text="{Binding Error}" TextColor="{StaticResource Accent}" SemanticProperties.Description="Помилка операції" />
   <Label x:Name="ImportStatus" TextColor="{StaticResource Sage}" />
   <Label x:Name="PdfStatus" TextColor="{StaticResource Sage}" IsVisible="False" />
   <Label x:Name="StartupError" TextColor="{StaticResource Accent}" />
   <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
    <Entry x:Name="LibraryFilter" Placeholder="Назва або мова документа" MaxLength="160"
     TextChanged="LibraryFilterChanged" SemanticProperties.Description="Пошук у бібліотеці за назвою або мовою" />
    <Button x:Name="ClearLibraryFilter" Grid.Column="1" Text="Очистити" Style="{StaticResource OutlineButton}"
     IsVisible="False" Clicked="ClearLibraryFilterClicked" SemanticProperties.Description="Очистити пошук у бібліотеці" />
   </Grid>
   <Label x:Name="NoMatchingBooks" Text="За цим запитом документів немає." TextColor="{StaticResource Muted}" IsVisible="False" />
  </VerticalStackLayout>
  <CollectionView Grid.Row="2" x:Name="Books" SelectionMode="Single" SelectionChanged="DocumentSelected"
   IsEnabled="{Binding CanInteract}" SizeChanged="BooksResized">
   <CollectionView.ItemsLayout>
    <GridItemsLayout x:Name="ShelfLayout" Orientation="Vertical" Span="2" HorizontalItemSpacing="18" VerticalItemSpacing="18" />
   </CollectionView.ItemsLayout>
   <CollectionView.ItemTemplate>
    <DataTemplate x:DataType="library:LibraryCard">
     <Grid>
      <Border IsVisible="{Binding IsDocument}" Padding="0" Stroke="{StaticResource BorderTone}"
       StrokeShape="RoundRectangle 9" BackgroundColor="{StaticResource Panel}">
       <Grid RowDefinitions="200,Auto">
        <Grid ColumnDefinitions="8,*" BackgroundColor="{Binding Cover}">
         <BoxView Color="{Binding Spine}" />
         <VerticalStackLayout Grid.Column="1" Padding="14,16" Spacing="12" VerticalOptions="Center">
          <Label Text="{Binding LanguageCode}" CharacterSpacing="2.2" FontSize="10"
           TextColor="{Binding CoverInk}" HorizontalTextAlignment="Center" />
          <Path HeightRequest="27" WidthRequest="28" HorizontalOptions="Center" Aspect="Uniform"
           Stroke="{Binding CoverInk}" StrokeThickness="1.5"
           Data="M12,5 C8,2 4,2 2,3 L2,19 C6,18 9,19 12,21 M12,5 C16,2 20,2 22,3 L22,19 C18,18 15,19 12,21 M12,5 L12,21" />
          <Label Text="{Binding Title}" Style="{StaticResource SerifTitle}" FontSize="26" TextColor="{Binding CoverInk}"
           HorizontalTextAlignment="Center" MaxLines="2" LineBreakMode="TailTruncation" />
         </VerticalStackLayout>
        </Grid>
        <VerticalStackLayout Grid.Row="1" Padding="14,13" Spacing="7">
         <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation" />
         <Label Text="{Binding Details}" TextColor="{StaticResource Muted}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" />
         <ProgressBar Progress="{Binding Progress}" ProgressColor="#9DAB88" HeightRequest="4" />
         <Label Text="{Binding ProgressLabel}" TextColor="{StaticResource Muted}" FontSize="11" />
         <Button Text="Джерело статті" IsVisible="{Binding HasArticleSource}" HorizontalOptions="Start" Style="{StaticResource OutlineButton}"
          Clicked="OpenArticleSourceClicked" CommandParameter="{Binding Document}" />
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
          <Button Text="Читати →" Style="{StaticResource OutlineButton}" Clicked="OpenCardClicked"
           CommandParameter="{Binding .}" SemanticProperties.Description="{Binding Title, StringFormat='Читати {0}'}" />
          <Button Grid.Column="1" Text="Мова" Style="{StaticResource OutlineButton}" Clicked="ChangeLanguageClicked"
           CommandParameter="{Binding Document}" SemanticProperties.Description="Змінити мову джерела" />
         </Grid>
         <FlexLayout Wrap="Wrap">
          <Button Text="Перейменувати" Style="{StaticResource OutlineButton}" Margin="0,0,6,0"
           Clicked="RenameDocumentClicked" CommandParameter="{Binding Document}"
           SemanticProperties.Description="{Binding Title, StringFormat='Перейменувати {0}'}" />
          <Button Text="Видалити" Style="{StaticResource OutlineButton}"
           Clicked="DeleteDocumentClicked" CommandParameter="{Binding Document}"
           SemanticProperties.Description="{Binding Title, StringFormat='Видалити {0}'}" />
         </FlexLayout>
        </VerticalStackLayout>
       </Grid>
      </Border>
      <Border IsVisible="{Binding IsNew}" Padding="14" Stroke="#D6D9CA" StrokeDashArray="5,4"
       StrokeShape="RoundRectangle 9" BackgroundColor="{StaticResource Panel}" MinimumHeightRequest="340">
       <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="11">
        <Label Text="Нова історія" Style="{StaticResource SerifTitle}" FontSize="24"
         TextColor="{StaticResource Sage}" HorizontalTextAlignment="Center" />
        <Label Text="TXT · DOCX · PDF · фото" TextColor="{StaticResource Muted}" FontSize="12" HorizontalTextAlignment="Center" />
        <Button Text="Додати документ" Style="{StaticResource OutlineButton}" Clicked="ChooseImportSourceClicked" HorizontalOptions="Center" />
       </VerticalStackLayout>
      </Border>
     </Grid>
    </DataTemplate>
   </CollectionView.ItemTemplate>
  </CollectionView>
 </Grid>
</ContentPage>
