<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Reader.Native</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiVersion>10.0.0</MauiVersion>
    <OnnxRuntimeVersion>1.30.0</OnnxRuntimeVersion>
    <OnnxRuntimePath>$(NuGetPackageRoot)microsoft.ml.onnxruntime/$(OnnxRuntimeVersion)</OnnxRuntimePath>
    <ApplicationTitle>Читай</ApplicationTitle>
    <ApplicationId>dev.lingoreader.native</ApplicationId>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst'))">26.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier Condition="$(TargetFramework.Contains('maccatalyst'))">maccatalyst-arm64</RuntimeIdentifier>
    <SupportedOSPlatformVersion
      Condition="$(TargetFramework.Contains('windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('windows'))">10.0.17763.0</TargetPlatformMinVersion>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('windows'))">
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.Contains('windows')) and '$(LingoMsix)' == 'true'">
    <WindowsPackageType>MSIX</WindowsPackageType>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifierOverride)' != ''">$(RuntimeIdentifierOverride)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Reader.Presentation/Reader.Presentation.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#63725C" />
    <MauiImage Include="Resources/Images/Navigation/*.svg" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#F6F3EC" BaseSize="128,128" />
    <MauiAsset Include="Resources/InferenceLicenses.txt" LogicalName="InferenceLicenses.txt" />
    <PackageDownload Include="Microsoft.ML.OnnxRuntime" Version="[$(OnnxRuntimeVersion)]" />
    <MauiAsset Include="$(OnnxRuntimePath)/LICENSE" LogicalName="OnnxRuntimeLicense.txt" />
    <MauiAsset Include="$(OnnxRuntimePath)/ThirdPartyNotices.txt" LogicalName="OnnxRuntimeThirdPartyNotices.txt" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.0" />
    <PackageReference Include="AngleSharp" Version="1.10.5" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('maccatalyst'))">
    <NativeReference Include="../../../target/aarch64-apple-ios-macabi/release/libreader_ffi.a">
      <Kind>Static</Kind><SmartLink>false</SmartLink>
      <Frameworks>Accelerate Foundation Metal</Frameworks>
      <LinkerFlags>-lc++ -u _reader_abi_version -u _reader_call -u _reader_close -u _reader_release -u _reader_fit_pdf_text</LinkerFlags>
    </NativeReference>
    <NativeReference Include="$(OnnxRuntimePath)/runtimes/ios/native/onnxruntime.xcframework.zip">
      <Kind>Static</Kind><SmartLink>false</SmartLink>
      <WeakFrameworks>CoreML</WeakFrameworks>
    </NativeReference>
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <Content Include="../../../target/x86_64-pc-windows-msvc/release/reader_ffi.dll"
      Link="reader_ffi.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OnnxRuntimePath)/runtimes/win-x64/native/onnxruntime.dll"
      Link="onnxruntime.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(OnnxRuntimePath)/runtimes/win-x64/native/onnxruntime_providers_shared.dll"
      Link="onnxruntime_providers_shared.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
